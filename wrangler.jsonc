{
  "name": "cinehub",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./build",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/admin",
      "/admin/*",
      "/backend/*",
      "/config.php",
      "/database.sql",
      "/api",
      "/backend",
      "/cloudflare/*",
      "/scripts/*",
      "/.git/*",
      "/security.php"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cinehub",
      "database_id": "0f2219c7-8d99-44e0-9a65-1d4ea562a6e6"
    }
  ],
  "build": {
    "command": "node scripts/prepare-cloudflare.cjs"
  },
  "workers_dev": true,
  "preview_urls": false
}
