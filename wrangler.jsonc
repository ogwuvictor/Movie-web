{
  "name": "cinehub-movie-web",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./build",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/admin",
      "/admin/*",
      "/backend/*",
      "/config.php",
      "/database.sql",
      "/api",
      "/backend",
      "/cloudflare/*",
      "/scripts/*",
      "/.git/*",
      "/security.php"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cinehub",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "build": {
    "command": "node scripts/prepare-cloudflare.cjs"
  },
  "workers_dev": true,
  "preview_urls": false
}
